{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@dcloudio/types"]
  },
  "include": ["env.d.ts", "src/**/*.ts", "pages/**/*.vue", "config/**/*.d.ts", "App.vue", "main.ts"]
}
